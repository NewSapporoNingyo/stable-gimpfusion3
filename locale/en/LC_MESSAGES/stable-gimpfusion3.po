#: sg_proc_arguments.py:291
msgid "Mask fill mode"
msgstr "Mask fill mode"

#: sg_proc_arguments.py:292
msgid ""
"Choose the fill content in mask\n"
"\n"
"fill: Fills the input image with the average color within the masked area. "
"Good for removing objects.\n"
"original: The input image is used as is.\n"
"latent noise: Fills the masked area with Seed-based noise. It can be used to "
"mask an object and rewrite the background. 1 is recommended for CGF.\n"
"latent nothing: Fills the masked area with the average color of the masked "
"area. It can be used to mask an object and rewrite the background. 0.8 or "
"higher is recommended for CGF.\n"
"        "
msgstr ""
"Choose the fill content in mask\n"
"\n"
"fill: Fills the input image with the average color within the masked area. "
"Good for removing objects.\n"
"original: The input image is used as is.\n"
"latent noise: Fills the masked area with Seed-based noise. It can be used to "
"mask an object and rewrite the background. 1 is recommended for CGF.\n"
"latent nothing: Fills the masked area with the average color of the masked "
"area. It can be used to mask an object and rewrite the background. 0.8 or "
"higher is recommended for CGF.\n"
"        "

