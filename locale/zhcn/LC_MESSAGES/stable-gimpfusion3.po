#: stable-gimpfusion3.py:58
msgid "Config"
msgstr "配置"

#: sg_generation.py:71
msgid "Seed must be an integer from -1 to 4294967295"
msgstr "种子必须为 -1 至 4294967295 的整数"

#: sg_generation.py:77 sg_plugins/generation_base.py:440
msgid "Width and height must be positive multiples of 8"
msgstr "宽高必须为正的 8 的倍数"

#: sg_proc_arguments.py:18 sg_proc_arguments.py:303
#: sg_plugins/generation_base.py:109
msgid "Model"
msgstr "模型"

#: sg_proc_arguments.py:19 sg_plugins/generation_base.py:109
msgid "Model to use for inference"
msgstr "用于生成的模型"

#: sg_proc_arguments.py:28
msgid "Add VAE and text encoders for Flux"
msgstr "添加 Flux 的 VAE 与文本编码器"

#: sg_proc_arguments.py:30
msgid ""
"Flux additional modules:\n"
"Autoguess: add the listed modules for Flux or GGUF model names.\n"
"Never add: use an empty additional-module list.\n"
"Always add: use the listed modules."
msgstr ""
"Flux 附加模块：\n"
"Autoguess：模型名包含 Flux 或以 GGUF 结尾时添加所列模块。\n"
"Never add：使用空的附加模块列表。\n"
"Always add：使用所列模块。"

#: sg_proc_arguments.py:57
msgid "Flux VAEs and text encoders"
msgstr "Flux VAE 与文本编码器"

#: sg_proc_arguments.py:58
msgid "Flux VAEs and text encoders to use for Flux-based models"
msgstr "Flux 模型使用的 VAE 与文本编码器"

#: sg_proc_arguments.py:67
msgid "Prompt"
msgstr "正向提示词"

#: sg_proc_arguments.py:68
msgid "A text string that describes the image you want to generate"
msgstr "描述要生成的图像"

#: sg_proc_arguments.py:74
msgid "Negative Prompt"
msgstr "负向提示词"

#: sg_proc_arguments.py:75
msgid "Features to reduce in the generated image"
msgstr "减少生成图像中的这些特征"

#: sg_proc_arguments.py:81
msgid "Seed"
msgstr "种子"

#: sg_proc_arguments.py:82
msgid "Seed: -1 for random, 0 or a positive integer for a fixed result"
msgstr "种子：-1 为随机，0 或正整数为固定种子"

#: sg_proc_arguments.py:90
msgid "Candidates"
msgstr "候选数量"

#: sg_proc_arguments.py:91
msgid "Number of candidate images generated in one batch"
msgstr "一次批量生成的候选图像数量"

#: sg_proc_arguments.py:99
msgid "Steps"
msgstr "采样步数"

#: sg_proc_arguments.py:100
msgid "Number of sampling steps; more steps increase generation time"
msgstr "采样步数；增加步数会延长生成时间"

#: sg_proc_arguments.py:108
msgid "Mask Blur"
msgstr "蒙版模糊"

#: sg_proc_arguments.py:109
msgid ""
"Gaussian blur radius in pixels on both sides of inpainting mask edges; "
"applies to inpaint"
msgstr "重绘蒙版边缘两侧的高斯模糊半径，单位为像素；适用于局部重绘"

#: sg_proc_arguments.py:117
msgid "Width"
msgstr "宽度"

#: sg_proc_arguments.py:118
msgid "Width of the image you want to generate"
msgstr "生成图像的宽度"

#: sg_proc_arguments.py:126
msgid "Height"
msgstr "高度"

#: sg_proc_arguments.py:127
msgid "Height of the image that you want to generate"
msgstr "生成图像的高度"

#: sg_proc_arguments.py:135
msgid "CFG Scale"
msgstr "CFG 强度"

#: sg_proc_arguments.py:136
msgid "Strength of prompt guidance during sampling"
msgstr "采样时提示词的引导强度"

#: sg_proc_arguments.py:144
msgid "Denoising Strength"
msgstr "降噪强度"

#: sg_proc_arguments.py:145
msgid ""
"Amount of change to the source image in img2img and inpaint; higher values "
"allow larger changes"
msgstr "图生图和局部重绘对来源图像的改动程度；数值越高，改动越大"

#: sg_proc_arguments.py:153
msgid "Sampler"
msgstr "采样器"

#: sg_proc_arguments.py:154
msgid "Sampler to use"
msgstr "使用的采样器"

#: sg_proc_arguments.py:161
msgid "Restore faces"
msgstr "修复面部"

#: sg_proc_arguments.py:162
msgid "Use GFPGAN / CodeFormer to restore faces"
msgstr "使用 GFPGAN / CodeFormer 修复面部"

#: sg_proc_arguments.py:168
msgid "Tiling"
msgstr "平铺纹理"

#: sg_proc_arguments.py:169
msgid "Generate a texture with seamless edges for tiling"
msgstr "生成边缘可无缝拼接的平铺纹理"

#: sg_proc_arguments.py:176
msgid "Insert mode"
msgstr "插入方式"

#: sg_proc_arguments.py:178
msgid ""
"Placement in txt2img:\n"
"Resize to selection: stretch to the selection dimensions.\n"
"Insert as is: keep the generated dimensions.\n"
"Aspect fill: scale proportionally to cover the selection.\n"
"Aspect fit: scale proportionally to fit inside the selection.\n"
"Use selection size: generate at the selection dimensions rounded to "
"multiples of 8.\n"
"Results are placed at the selection top-left corner."
msgstr ""
"文生图的放置方式：\n"
"Resize to selection：拉伸到选区宽高。\n"
"Insert as is：保留生成尺寸。\n"
"Aspect fill：等比缩放并覆盖选区。\n"
"Aspect fit：等比缩放并放入选区。\n"
"Use selection size：按选区尺寸生成，宽高取整为 8 的倍数。\n"
"结果放在选区左上角。"

#: sg_proc_arguments.py:195
msgid "Enable ControlNet 1"
msgstr "启用 ControlNet 1"

#: sg_proc_arguments.py:196
msgid "Enable ControlNet 1 for generation"
msgstr "生成时启用 ControlNet 1"

#: sg_proc_arguments.py:202
msgid "ControlNet 1 Layer"
msgstr "ControlNet 1 图层"

#: sg_proc_arguments.py:203
msgid "ControlNet 1 Layer for generation"
msgstr "生成时使用的 ControlNet 1 输入图层"

#: sg_proc_arguments.py:209
msgid "Enable ControlNet 2"
msgstr "启用 ControlNet 2"

#: sg_proc_arguments.py:210
msgid "Enable ControlNet 2 for generation"
msgstr "生成时启用 ControlNet 2"

#: sg_proc_arguments.py:216
msgid "ControlNet 2 Layer"
msgstr "ControlNet 2 图层"

#: sg_proc_arguments.py:217
msgid "ControlNet 2 Layer for generation"
msgstr "生成时使用的 ControlNet 2 输入图层"

#: sg_proc_arguments.py:223
msgid "Import candidates only"
msgstr "只导入生成候选"

#: sg_proc_arguments.py:225
msgid ""
"Enabled: import generated candidates. Disabled: also import ControlNet "
"preprocessing or reference images. Applies to all three modes."
msgstr ""
"开启时导入生成候选；关闭时同时导入 ControlNet 返回的预处理图或参考图。适用于"
"三种生成模式。"

#: sg_proc_arguments.py:236 sg_proc_arguments.py:304
msgid "Resize Mode"
msgstr "缩放方式"

#: sg_proc_arguments.py:238
msgid ""
"Resizing in img2img and inpaint:\n"
"Just Resize: stretch to the requested dimensions.\n"
"Crop And Resize: scale proportionally to cover the frame, then crop.\n"
"Resize And Fill: fit inside the frame and extend the edge colors.\n"
"Just Resize (Latent Upscale): resize in latent space."
msgstr ""
"图生图和局部重绘的缩放方式：\n"
"Just Resize：拉伸到请求尺寸。\n"
"Crop And Resize：等比缩放并覆盖画框，再裁剪。\n"
"Resize And Fill：等比放入画框，用边缘颜色填充空白。\n"
"Just Resize (Latent Upscale)：在潜空间缩放。"

#: sg_proc_arguments.py:253
msgid "Invert Mask"
msgstr "反转蒙版"

#: sg_proc_arguments.py:254
msgid ""
"Enabled: repaint the black mask area. Disabled: repaint the white mask area."
msgstr "开启时重绘蒙版黑色区域；关闭时重绘白色区域。"

#: sg_proc_arguments.py:260 sg_plugins/generation_base.py:357
msgid "Inpaint area"
msgstr "重绘区域"

#: sg_proc_arguments.py:262
msgid ""
"Whole picture samples the entire source; Only masked samples the mask area "
"and composites it into the source"
msgstr "全图按整张来源采样；仅蒙版区域对蒙版范围采样后合回来源"

#: sg_proc_arguments.py:270
msgid "Only masked padding, pixels"
msgstr "蒙版区域边距（像素）"

#: sg_proc_arguments.py:271
msgid "Context added around the mask before sampling in Only masked mode"
msgstr "仅蒙版区域模式下，采样前在蒙版周围增加的上下文范围"

#: sg_proc_arguments.py:279
msgid "Mask fill mode"
msgstr "蒙版填充方式"

#: sg_proc_arguments.py:281
msgid ""
"Initial content in the inpainting mask:\n"
"fill: fill using surrounding colors.\n"
"original: use the source content.\n"
"latent noise: initialize with seeded latent noise.\n"
"latent nothing: initialize the masked latent values to zero."
msgstr ""
"重绘蒙版内的初始内容：\n"
"fill：用周围颜色填充。\n"
"original：使用来源内容。\n"
"latent noise：使用种子产生的潜空间噪声。\n"
"latent nothing：将蒙版区域的初始潜变量置零。"

#: sg_proc_arguments.py:302
msgid "Module"
msgstr "预处理器"

#: sg_proc_arguments.py:302
msgid "ControlNet preprocessor applied to the input layer"
msgstr "应用于输入图层的 ControlNet 预处理器"

#: sg_proc_arguments.py:303
msgid "ControlNet model paired with the preprocessor"
msgstr "与预处理器配合使用的 ControlNet 模型"

#: sg_proc_arguments.py:304
msgid "Fit the ControlNet input to the generation frame"
msgstr "将 ControlNet 输入适配到生成画框"

#: sg_proc_arguments.py:305
msgid "Control Mode"
msgstr "控制方式"

#: sg_proc_arguments.py:305
msgid "Balance prompt guidance and ControlNet guidance"
msgstr "平衡提示词与 ControlNet 的引导作用"

#: sg_proc_arguments.py:316
msgid "Weight"
msgstr "权重"

#: sg_proc_arguments.py:316
msgid "Strength of the ControlNet condition"
msgstr "ControlNet 条件的影响强度"

#: sg_proc_arguments.py:319
msgid "Guidance Start (T)"
msgstr "引导起点"

#: sg_proc_arguments.py:320
msgid "Sampling progress at which ControlNet starts; 0 is the beginning"
msgstr "ControlNet 开始参与的采样进度；0 为起点"

#: sg_proc_arguments.py:325
msgid "Guidance End (T)"
msgstr "引导终点"

#: sg_proc_arguments.py:325
msgid "Sampling progress at which ControlNet ends; 1 is the end"
msgstr "ControlNet 结束参与的采样进度；1 为终点"

#: sg_proc_arguments.py:328
msgid "Threshold A"
msgstr "阈值 A"

#: sg_proc_arguments.py:329
msgid ""
"First preprocessor parameter; meaning and range depend on the selected module"
msgstr "预处理器的第一个参数；含义和范围由所选预处理器决定"

#: sg_proc_arguments.py:336
msgid "Threshold B"
msgstr "阈值 B"

#: sg_proc_arguments.py:337
msgid ""
"Second preprocessor parameter; meaning and range depend on the selected "
